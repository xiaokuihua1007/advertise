<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.classmatechen.sample.mapper.PlatformImageMapper">

    <update id="updatePath">
        update platform_image set path = #{ path } where id = #{ id }
    </update>

    <select id="list">
        select * from platform_image where 1 = 1
        <if test="null != platform">
            and platform = #{ platform }
        </if>
        <if test="null != pathExist and true == pathExist">
            and path is not null
        </if>
        <if test="null != pathExist and false == pathExist">
            and path is null
        </if>
    </select>
</mapper>
